# Athena remains local-only with this default. Do not use 0.0.0.0 unless you
# understand that the interface has no authentication.
ATHENA_HOST=127.0.0.1
ATHENA_PORT=8000

# Mutable data defaults to the repository directory. Set an absolute path to
# store conversations and generated workspace files somewhere else.
# ATHENA_DATA_DIR=C:\Users\YourName\AppData\Local\Athena

# Ollama model tags. Defaults are shown here for clarity.
ATHENA_BALANCED_MODEL=gemma3:12b
ATHENA_FAST_MODEL=qwen3:8b
ATHENA_FAST_VISION_MODEL=gemma3:4b
ATHENA_EMBED_MODEL=nomic-embed-text

# Maximum document size Athena will read, in bytes (default: 10 MiB).
ATHENA_MAX_FILE_SIZE=10485760

# Generous safety ceilings for local generation. These stop a looping model
# without constraining ordinary answers or generated office-file scripts.
ATHENA_RESPONSE_MAX_TOKENS=1536
ATHENA_PLANNER_MAX_TOKENS=1024
ATHENA_ROUTER_MAX_TOKENS=64
ATHENA_CODE_MAX_TOKENS=4096
ATHENA_CODE_REPAIR_ATTEMPTS=2

# Optional when Tesseract is already on PATH. Otherwise use its full path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
